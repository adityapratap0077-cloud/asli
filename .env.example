# ASLI — environment template. Copy to .env.local for local dev.
# Production values go in the Vercel dashboard (Project → Settings → Environment Variables).

# --- Orders backend (Supabase) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Owner dashboard -------------------------------------------------------
# Secret key that unlocks /dashboard and the owner-only order APIs.
OWNER_DASHBOARD_KEY=pick-a-long-random-secret

# --- Public site URL (used to absolutize local artwork for Qikink) ---------
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# --- Qikink Open API (print-on-demand fulfillment) ---------------------------
# From the Qikink dashboard: Integration → Custom API.
# Official docs: https://documenter.getpostman.com/view/26157218/2sBYAysUHS
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
# Sandbox for testing, production for real orders:
#   QIKINK_API_URL=https://sandbox.qikink.com
QIKINK_API_URL=https://sandbox.qikink.com
# API paths (verified against Qikink's official docs on 2026-09-23):
QIKINK_TOKEN_PATH=/api/token
QIKINK_ORDER_PATH=/api/order/create
# Gateway sent with each order — case-sensitive, must be COD or Prepaid:
QIKINK_GATEWAY=Prepaid
# Print type for your garments (DTF = 17, DTG cotton = 1; full enum in docs):
QIKINK_PRINT_TYPE_ID=17
# Map each ASLI product (+ optional color/size-specific keys like
# "oversized:black:XL") to its Qikink SKU. Find SKUs in the Qikink
# dashboard product catalog. Most specific key wins; plain product id
# is the fallback. "placement" is front or back.
# Orders for unmapped products fail gracefully and stay in the dashboard
# for manual entry — nothing is ever silently dropped.
QIKINK_PRODUCT_MAP={"oversized":{"sku":"","placement":"front"},"regular":{"sku":"","placement":"front"},"hoodie":{"sku":"","placement":"front"}}
